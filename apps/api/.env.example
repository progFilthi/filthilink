# ─── Database ─────────────────────────────────────────────────
# Local default matches compose.yaml; in production use the Contabo Postgres.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/filthiLinkDb
SPRING_DATASOURCE_USERNAME=filthi
SPRING_DATASOURCE_PASSWORD=filthi_pass

# ─── JWT ──────────────────────────────────────────────────────
# 256-bit+ random value. Generate with: openssl rand -base64 48
JWT_SECRET=

# ─── Google OAuth ─────────────────────────────────────────────
CLIENT_ID=
CLIENT_SECRET=

# ─── Admin ────────────────────────────────────────────────────
# Comma-separated emails that get the ADMIN role on login/register.
ADMIN_EMAILS=

# ─── Dodo Payments ────────────────────────────────────────────
DODO_API_KEY=
DODO_WEBHOOK_KEY=
DODO_ENVIRONMENT=sandbox
PREMIUM_MONTHLY=
PREMIUM_YEARLY=

# ─── Server ───────────────────────────────────────────────────
PORT=8080
